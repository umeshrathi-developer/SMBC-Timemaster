# Environment Configuration Example

# Create a .env file in the project root and copy these settings
# For development only - do NOT use in production with real secrets!

# ============== DJANGO SETTINGS ==============

# Set to False in production!
DEBUG=False

# Change this to a secret random string in production
SECRET_KEY=django-insecure-tr@p%q8j#9$k!z&*@x7v#1m9p&k@3r!9&5j8m#1k$5l&9n#2q

# Allowed hosts for your server (space-separated)
ALLOWED_HOSTS=127.0.0.1 localhost

# ============== DATABASE ==============

# SQLite (default - suitable for private network)
# DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/timemaster_db

# ============== EMAIL SETTINGS ==============

# SMTP Configuration for password reset emails
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
DEFAULT_FROM_EMAIL=""

# ============== SECURITY ==============

# CSRF Protection
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Session settings
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
CSRF_COOKIE_SECURE=False     # Set to True in production with HTTPS

# ============== LOGGING ==============

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============== NETWORK ==============

# IP address to bind to
BIND_IP=0.0.0.0

# Port to run on
PORT=8000

# ============== APPLICATION SETTINGS ==============

# Application name
APP_NAME=Timesheet & Comp-Off Management

# Company name
COMPANY_NAME=Your Company

# Time zone (use Django timezone format)
TIME_ZONE=UTC

# ============== PRIVATE NETWORK SETTINGS ==============

# Your internal IP address (find with ipconfig on Windows or ifconfig on Linux/Mac)
SERVER_IP=192.168.1.100

# Internal hostname (if available)
SERVER_HOSTNAME=timemaster.company.local

# ==============================================
# PRODUCTION SETTINGS (for deployment)
# ==============================================

# Set these when deploying to production:

# DEBUG=False
# SECRET_KEY=<generate-a-new-secure-key>
# ALLOWED_HOSTS=192.168.1.100 timemaster.company.local
# DATABASE_URL=postgresql://user:password@db-server:5432/timemaster
# EMAIL_HOST_USER=admin@company.com
# EMAIL_HOST_PASSWORD=<app-password>
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True

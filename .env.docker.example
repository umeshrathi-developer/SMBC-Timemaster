# Copy this file to .env on the server and adjust values before running Docker Compose.

TIMEMASTER_HOST_PORT=8000

DEBUG=False
SECRET_KEY=change-me-to-a-long-random-secret
ALLOWED_HOSTS=localhost 127.0.0.1 192.168.1.100 timemaster.company.local
CSRF_TRUSTED_ORIGINS=http://localhost:8000 http://192.168.1.100:8000 http://timemaster.company.local:8000
TIME_ZONE=UTC

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

ACCRUAL_SUMMARY_TO_EMAILS=
ACCRUAL_SUMMARY_CC_EMAILS=

# Keep True when this single container must serve uploaded media itself.
# Put media behind nginx/caddy and set False if a reverse proxy serves /media/.
SERVE_MEDIA=True
